<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/titan_background"
    android:padding="20dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_title"
        android:textColor="@color/titan_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack" />

    <Spinner
        android:id="@+id/spinnerExercise"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_input"
        android:popupBackground="@color/titan_surface"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:30"
        android:textColor="@color/titan_timer"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerExercise"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/inputRest"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/hint_rest"
        android:inputType="number"
        android:text="30"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/titan_text"
        android:textColorHint="@color/titan_text_muted"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnStartRest" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartRest"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/btn_start_rest"
        android:textColor="@color/titan_button_text"
        app:backgroundTint="@color/titan_primary"
        app:cornerRadius="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/inputRest"
        app:layout_constraintBottom_toBottomOf="@id/inputRest"
        app:layout_constraintStart_toEndOf="@id/inputRest"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/inputKg"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/hint_kg"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/titan_text"
        android:textColorHint="@color/titan_text_muted"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/inputRest"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inputReps" />

    <EditText
        android:id="@+id/inputReps"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/hint_reps"
        android:inputType="number"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/titan_text"
        android:textColorHint="@color/titan_text_muted"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/inputKg"
        app:layout_constraintBottom_toBottomOf="@id/inputKg"
        app:layout_constraintStart_toEndOf="@id/inputKg"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddSeries"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/btn_add_series"
        android:textColor="@color/titan_button_text"
        android:textStyle="bold"
        app:backgroundTint="@color/titan_accent"
        app:cornerRadius="12dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/inputKg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSeriesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/series_header"
        android:textColor="@color/titan_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddSeries"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSeries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtSeriesHeader"
        app:layout_constraintBottom_toTopOf="@id/btnFinish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinish"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/btn_finish_session"
        android:textColor="@color/titan_text"
        app:strokeColor="@color/titan_accent"
        app:strokeWidth="1dp"
        app:backgroundTint="@color/titan_background"
        app:cornerRadius="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/recyclerSeries"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>